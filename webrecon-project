#!/usr/bin/env python3
import sys
import argparse
import requests

def main():
    parser = argparse.ArgumentParser(
        description="A lightweight web reconnaissance and admin path finder tool."
    )
    parser.add_argument(
        "-u", "--url", 
        required=True, 
        help="Target website URL (e.g., http://192.168.1.50)"
    )
    parser.add_argument(
        "-w", "--wordlist", 
        default="/usr/share/wordlists/common.txt", 
        help="Path to custom wordlist file"
    )
    parser.add_argument(
        "-o", "--output",
        help="Path to save scan results to a text file"
    )
    
    args = parser.parse_args()
    target_url = args.url
    
    default_paths = [
        "admin", "administrator", "admin/login", "admin_area", "dashboard",
        "moderator", "controlpanel", "cp", "manage", "management",
        "login", "signin", "auth", "register", "signup", "user/login",
        "config", "configuration", "setup", "install", "settings",
        "environment", ".env", "phpinfo.php", "server-status",
        "api", "api/v1", "api/v2", "swagger", "docs", "graphql",
        "backup", "backups", "bak", "archive.zip", "db.sql", "error.log",
        "test", "robots.txt", "sitemap.xml", "wp-admin", "wp-login.php",
        "panel", "webmail", "db", "database", "phpmyadmin"
    ]
    
    print(f"[*] Scanning target: {target_url}\n")
    
    outfile = None
    if args.output:
        try:
            outfile = open(args.output, "w", encoding="utf-8")
            outfile.write(f"Scan results for target: {target_url}\n\n")
        except IOError as e:
            print(f"[-] Error opening output file: {e}")
            sys.exit(1)
            
    try:
        for path in default_paths:
            url = f"{target_url.rstrip('/')}/{path}"
            try:
                response = requests.get(url, timeout=3, allow_redirects=False)
                
                message = ""
                if response.status_code == 200:
                    message = f"[+] FOUND (200 OK): {url}"
                elif response.status_code == 403:
                    message = f"[!] FORBIDDEN (403): {url} (Protected area)"
                elif response.status_code in [301, 302]:
                    message = f"[~] REDIRECT ({response.status_code}): {url}"
                    
                if message:
                    print(message)
                    if outfile:
                        outfile.write(message + "\n")
                        
            except requests.exceptions.RequestException:
                pass
    finally:
        if outfile:
            outfile.close()
            print(f"\n[*] Results successfully saved to {args.output}")

if __name__ == "__main__":
    main()
