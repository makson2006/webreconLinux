#!/usr/bin/env python3
import sys
import argparse
import socket
from urllib.parse import urlparse
import requests

def scan_ports(target_host, target_ip, outfile=None):
    common_ports = [21, 22, 23, 25, 53, 80, 110, 135, 139, 443, 445, 3306, 3389, 8080, 8443]
    
    print(f"\n[*] Resolving {target_host} to IP address...")
    try:
        resolved_ip = socket.gethostbyname(target_host)
        print(f"[+] Target IP found: {resolved_ip}")
    except socket.gaierror as e:
        print(f"[-] Failed to resolve hostname {target_host}: {e}")
        return

    print(f"[*] Starting port scan on: {resolved_ip}")
    if outfile:
        outfile.write(f"\n--- Port Scan Results for {target_host} ({resolved_ip}) ---\n")
        
    for port in common_ports:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.0)
            result = s.connect_ex((resolved_ip, port))
            
            if result == 0:
                message = f"[+] PORT OPEN: {port}"
                print(message)
                if outfile:
                    outfile.write(message + "\n")
            s.close()
        except socket.error:
            pass

def main():
    parser = argparse.ArgumentParser(
        description="A lightweight web reconnaissance, admin path finder, and port scanner tool."
    )
    parser.add_argument(
        "-u", "--url", 
        required=True, 
        help="Target website URL or domain (e.g., example.com or http://192.168.1.50)"
    )
    parser.add_argument(
        "-w", "--wordlist", 
        default="/usr/share/wordlists/common.txt", 
        help="Path to custom wordlist file"
    )
    parser.add_argument(
        "-o", "--output",
        help="Path to save scan results to a text file"
    )
    parser.add_argument(
        "-p", "--paths",
        action="store_true",
        help="Enable web path reconnaissance"
    )
    parser.add_argument(
        "-P", "--ports",
        action="store_true",
        help="Enable TCP port scanning"
    )
    
    args = parser.parse_args()
    target_input = args.url
    
    # Ensure URL has a scheme so urlparse handles it correctly
    if "://" not in target_input:
        target_input_full = f"http://{target_input}"
    else:
        target_input_full = target_input
        
    parsed_url = urlparse(target_input_full)
    target_host = parsed_url.hostname
    target_url = target_input_full
    
    default_paths = [
        "admin", "administrator", "admin/login", "admin_area", "dashboard",
        "moderator", "controlpanel", "cp", "manage", "management",
        "login", "signin", "auth", "register", "signup", "user/login",
        "config", "configuration", "setup", "install", "settings",
        "environment", ".env", "phpinfo.php", "server-status",
        "api", "api/v1", "api/v2", "swagger", "docs", "graphql",
        "backup", "backups", "bak", "archive.zip", "db.sql", "error.log",
        "test", "robots.txt", "sitemap.xml", "wp-admin", "wp-login.php",
        "panel", "webmail", "db", "database", "phpmyadmin"
    ]
    
    # Default to paths if neither flag is specified
    run_paths = args.paths or (not args.paths and not args.ports)
    run_ports = args.ports
    
    # Open output file if specified
    outfile = None
    if args.output:
        try:
            outfile = open(args.output, "w", encoding="utf-8")
            outfile.write(f"Scan target: {target_input}\n")
        except IOError as e:
            print(f"[-] Error opening output file: {e}")
            sys.exit(1)
            
    try:
        # 1. Run Web Path Reconnaissance
        if run_paths:
            print(f"[*] Scanning web paths on: {target_url}\n")
            if outfile:
                outfile.write("--- Web Path Reconnaissance ---\n")
                
            for path in default_paths:
                url = f"{target_url.rstrip('/')}/{path}"
                try:
                    response = requests.get(url, timeout=3, allow_redirects=False)
                    
                    message = ""
                    if response.status_code == 200:
                        message = f"[+] FOUND (200 OK): {url}"
                    elif response.status_code == 403:
                        message = f"[!] FORBIDDEN (403): {url} (Protected area)"
                    elif response.status_code in [301, 302]:
                        message = f"[~] REDIRECT ({response.status_code}): {url}"
                        
                    if message:
                        print(message)
                        if outfile:
                            outfile.write(message + "\n")
                            
                except requests.exceptions.RequestException:
                    pass
                
        # 2. Run Port Scan (Automatically resolves domain to IP)
        if run_ports:
            scan_ports(target_host, target_host, outfile)
            
    finally:
        if outfile:
            outfile.close()
            print(f"\n[*] Results successfully saved to {args.output}")

if __name__ == "__main__":
    main()